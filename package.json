{
  "name": "@forspring/suite-signin",
  "version": "0.1.0",
  "description": "Forspring suite console sign-in: an OIDC client of the Forspring account, with sessions, single sign-out and back-channel logout, for Cloudflare Workers",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./directory": {
      "types": "./dist/directory.d.ts",
      "default": "./dist/directory.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "default": "./dist/d1.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build && git diff --exit-code dist"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
